{
  "name": "devcrew",
  "displayName": "DevCrew",
  "description": "Parallel AI agent team for collaborative software development in VSCode",
  "version": "0.1.0",
  "publisher": "devcrew",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Machine Learning"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devcrew.startTeam",
        "title": "DevCrew: Start Team",
        "icon": "$(play)"
      },
      {
        "command": "devcrew.stopTeam",
        "title": "DevCrew: Stop Team",
        "icon": "$(debug-stop)"
      },
      {
        "command": "devcrew.pauseTeam",
        "title": "DevCrew: Pause Team",
        "icon": "$(debug-pause)"
      },
      {
        "command": "devcrew.resumeTeam",
        "title": "DevCrew: Resume Team",
        "icon": "$(debug-continue)"
      },
      {
        "command": "devcrew.assignTask",
        "title": "DevCrew: Assign Task to Team",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "devcrew.showDashboard",
        "title": "DevCrew: Show Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "devcrew.teamChat",
        "title": "DevCrew: Chat with Team Lead",
        "icon": "$(comment)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devcrew-sidebar",
          "title": "DevCrew",
          "icon": "$(organization)"
        }
      ]
    },
    "views": {
      "devcrew-sidebar": [
        {
          "id": "devcrew-team",
          "name": "Team"
        },
        {
          "id": "devcrew-tasks",
          "name": "Task Board"
        },
        {
          "id": "devcrew-activity",
          "name": "Activity Feed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "devcrew-team",
        "contents": "Welcome to DevCrew!\n\nStart a parallel AI agent team to collaboratively work on coding tasks.\n\n[$(play) Start Team](command:devcrew.startTeam)\n\n[$(gear) Configure Settings](command:workbench.action.openSettings?%5B%22devcrew%22%5D)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "devcrew.startTeam",
          "when": "view == devcrew-team && !devcrew:teamRunning",
          "group": "navigation"
        },
        {
          "command": "devcrew.stopTeam",
          "when": "view == devcrew-team && devcrew:teamRunning",
          "group": "navigation"
        },
        {
          "command": "devcrew.pauseTeam",
          "when": "view == devcrew-team && devcrew:teamRunning && !devcrew:teamPaused",
          "group": "navigation"
        },
        {
          "command": "devcrew.resumeTeam",
          "when": "view == devcrew-team && devcrew:teamPaused",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "DevCrew",
      "properties": {
        "devcrew.team.composition": {
          "type": "array",
          "default": [
            "architect",
            "frontend",
            "backend",
            "tester",
            "reviewer"
          ],
          "items": {
            "type": "string",
            "enum": [
              "architect",
              "frontend",
              "backend",
              "tester",
              "reviewer",
              "devops",
              "security",
              "docs"
            ]
          },
          "description": "Role templates available for the Team Lead to choose from when staffing. The Team Lead creates agents dynamically per-request — this list does not determine the fixed team composition."
        },
        "devcrew.team.maxParallelAgents": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 8,
          "description": "Maximum number of agents working in parallel"
        },
        "devcrew.fileOps.requireApproval": {
          "type": "boolean",
          "default": true,
          "description": "Require user approval before agents write files"
        },
        "devcrew.fileOps.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save files after agent edits"
        },
        "devcrew.notifications.level": {
          "type": "string",
          "default": "important",
          "enum": [
            "all",
            "important",
            "errors-only",
            "none"
          ],
          "description": "Notification verbosity level"
        },
        "devcrew.agent.maxIterationsPerTask": {
          "type": "number",
          "default": 50,
          "minimum": 5,
          "maximum": 200,
          "description": "Maximum LLM round-trips an agent can take per task before stopping"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^8.56.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "vitest": "^2.1.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
